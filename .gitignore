*.log
.DS_Store
.env
.env.backup
.env.production
# Catch-all: any .env variant, including dated backups made before an edit.
# The three patterns above only matched exact names, so a file like
# .env.bak-20260806 was left untracked-but-committable — one `git add -A`
# away from publishing live credentials.
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Android/TWA build output. The keystore in particular must never be committed —
# it is the upload key and cannot be replaced once the app is listed.
/build/twa
*.jks
*.keystore

# Server-generated, not app code
/public/awstats-icon
/public/awstatsicons
/public/icon
/storage/media-library/temp
