<?xml version="1.0" encoding="UTF-8"?>
<!--
  Samsung TV (Tizen) packaging for the GrinMuzik TV app.
  `npm run package:tizen` copies this file and icon.png next to the built app
  in build/tizen/, which Tizen Studio (or the `tizen package` CLI) signs into a
  .wgt with the owner's Samsung certificate.
  required_version 3.0 = the 2017 models; newer TVs run it too.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://grinmuzik.com/tv-app" version="1.0.0" viewmodes="maximized">
    <tizen:application id="GrnMuzkTV1.GrinMuzik" package="GrnMuzkTV1" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>GrinMuzik</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <!-- The API is on grinmuzik.com; audio and covers come from Cloudflare R2
         hosts whose names vary, so network access is open. -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
