# Grinmuzik API base URL
GRINMUZIK_API_URL=https://your-domain.com/api

# Sanctum token generated from the admin panel → Settings → MCP API Keys
# Must have at minimum the 'read' ability; add 'write' for action tools
GRINMUZIK_API_KEY=

# --- HTTP / SSE server (npm run start:http) ---

# Port the SSE server listens on (default 3001)
PORT=3001

# Bearer token clients must send in the Authorization header to connect.
# Defaults to GRINMUZIK_API_KEY if not set — so the same Sanctum token
# can be reused in the Claude Desktop config.
MCP_ACCESS_KEY=
