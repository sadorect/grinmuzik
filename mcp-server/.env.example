# ── GrinMuzik API ──────────────────────────────────────────────────────────────
# Base URL for the Laravel API (use http://localhost:8000/api for local dev)
GRINMUZIK_API_URL=https://your-domain.com/api

# Sanctum token generated from the admin panel → Settings → MCP API Keys
# Must have at minimum the 'read' ability; add 'write' for admin tools
GRINMUZIK_API_KEY=

# ── HTTP / SSE server (npm run start:http) ─────────────────────────────────────
# Port the HTTP MCP server listens on (default 3001)
PORT=3001

# Bearer token clients must send in the Authorization header to connect.
# Defaults to GRINMUZIK_API_KEY if not set.
MCP_ACCESS_KEY=

# ── Phase 4A – MyAnniversary API ───────────────────────────────────────────────
MYANNIVERSARY_API_URL=https://myanniversary.com.ng/api
MYANNIVERSARY_API_KEY=

# ── Phase 4B – VPS SSH ─────────────────────────────────────────────────────────
VPS_SSH_HOST=your-vps-ip
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=/home/youruser/.ssh/id_rsa

# Optional: MySQL credentials for vps_get_failed_jobs_all
VPS_DB_USER=root
VPS_DB_PASS=

# ── Phase 6 – Production MCP server key ────────────────────────────────────────
MCP_SERVER_KEY=your-mcp-server-secret
